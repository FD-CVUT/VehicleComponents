"""
A 143 A charger at 400 V: 20 kW gives 50 A, 100 kW would give 250 A and is capped at 143 A, and
negative power gives nothing. At 0 V the one-volt floor turns 50 W into 50 A.
"""
test component CCCVPowerCurrent
  pack = BlockComponents.Sources.Constant(k = 400.0)
  dead = BlockComponents.Sources.Constant(k = 0.0)
  moderate = BlockComponents.Sources.Constant(k = 20000.0)
  high = BlockComponents.Sources.Constant(k = 100000.0)
  negative = BlockComponents.Sources.Constant(k = -5000.0)
  small = BlockComponents.Sources.Constant(k = 50.0)
  limited = VehicleComponents.Electrical.Battery.Helpers.CCCVPowerCurrent(I_cc = 143.0)
  capped = VehicleComponents.Electrical.Battery.Helpers.CCCVPowerCurrent(I_cc = 143.0)
  blocked = VehicleComponents.Electrical.Battery.Helpers.CCCVPowerCurrent(I_cc = 143.0)
  floored = VehicleComponents.Electrical.Battery.Helpers.CCCVPowerCurrent(I_cc = 143.0)
relations
  connect(pack.y, limited.u1, capped.u1, blocked.u1)
  connect(dead.y, floored.u1)
  connect(moderate.y, limited.u2)
  connect(high.y, capped.u2)
  connect(negative.y, blocked.u2)
  connect(small.y, floored.u2)
metadata {
  "Dyad": {
    "tests": {
      "four_regions": {
        "stop": 1,
        "solver": "Auto",
        "abstol": 1e-9,
        "reltol": 1e-9,
        "atol": {"limited.y": 1e-9, "capped.y": 1e-9, "blocked.y": 1e-9, "floored.y": 1e-9},
        "expect": {
          "final": {"limited.y": 50.0, "capped.y": 143.0, "blocked.y": 0.0, "floored.y": 50.0}
        }
      }
    }
  }
}
end

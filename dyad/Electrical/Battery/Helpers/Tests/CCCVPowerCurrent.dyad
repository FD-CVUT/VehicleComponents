"""
A 143 A charger at 400 V: 20 kW gives 50 A, 100 kW would give 250 A and is capped at 143 A, and
negative power gives nothing. At 0 V the one-volt floor turns 50 W into 50 A.
"""
test component CCCVPowerCurrent
  voltage = BlockComponents.Sources.Constant(k = 400.0) {
    "Dyad": {"placement": {"diagram": {"x1": 200, "x2": 300, "y1": 200, "y2": 300}}}
  }
  power = BlockComponents.Sources.Constant(k = 20000.0) {
    "Dyad": {"placement": {"diagram": {"x1": 200, "x2": 300, "y1": 450, "y2": 550}}}
  }
  ceiling = VehicleComponents.Electrical.Battery.Helpers.CCCVPowerCurrent(I_cc = 143.0) {
    "Dyad": {"placement": {"diagram": {"x1": 450, "x2": 550, "y1": 350, "y2": 450}}}
  }
relations
  connect(voltage.y, ceiling.u1) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 400, "y": 250}, {"x": 400, "y": 370}], "E": 2}],
      "path": {}
    }
  }
  connect(power.y, ceiling.u2) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 400, "y": 500}, {"x": 400, "y": 430}], "E": 2}],
      "path": {}
    }
  }
metadata {
  "Dyad": {
    "tests": {
      "power_limited": {
        "stop": 1,
        "solver": "Auto",
        "abstol": 1e-9,
        "reltol": 1e-9,
        "atol": {"ceiling.y": 1e-9},
        "expect": {"final": {"ceiling.y": 50.0}}
      },
      "current_capped": {
        "stop": 1,
        "solver": "Auto",
        "abstol": 1e-9,
        "reltol": 1e-9,
        "params": {"power.k": 100000.0},
        "atol": {"ceiling.y": 1e-9},
        "expect": {"final": {"ceiling.y": 143.0}}
      },
      "negative_power": {
        "stop": 1,
        "solver": "Auto",
        "abstol": 1e-9,
        "reltol": 1e-9,
        "params": {"power.k": -5000.0},
        "atol": {"ceiling.y": 1e-9},
        "expect": {"final": {"ceiling.y": 0.0}}
      },
      "voltage_floor": {
        "stop": 1,
        "solver": "Auto",
        "abstol": 1e-9,
        "reltol": 1e-9,
        "params": {"voltage.k": 0.0, "power.k": 50.0},
        "atol": {"ceiling.y": 1e-9},
        "expect": {"final": {"ceiling.y": 50.0}}
      }
    }
  }
}
end

"""
The factor is 1 at the reference temperature, 298.15 K, and at 0 °C (273.15 K) it is
exp(12500 / 8.314 (1 / 273.15 - 1 / 298.15)) = 1.5865.
"""
test component ArrheniusFactor
  temperature = BlockComponents.Sources.Constant(k = 298.15) {
    "Dyad": {"placement": {"diagram": {"x1": 200, "x2": 300, "y1": 200, "y2": 300}}}
  }
  factor = VehicleComponents.Electrical.Battery.Helpers.ArrheniusFactor() {
    "Dyad": {"placement": {"diagram": {"x1": 450, "x2": 550, "y1": 200, "y2": 300}}}
  }
relations
  connect(temperature.y, factor.u) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
metadata {
  "Dyad": {
    "tests": {
      "reference": {
        "stop": 1,
        "solver": "Auto",
        "abstol": 1e-9,
        "reltol": 1e-9,
        "atol": {"factor.y": 1e-9},
        "expect": {"final": {"factor.y": 1.0}}
      },
      "freezing": {
        "stop": 1,
        "solver": "Auto",
        "abstol": 1e-9,
        "reltol": 1e-9,
        "params": {"temperature.k": 273.15},
        "atol": {"factor.y": 1e-9},
        "expect": {"final": {"factor.y": 1.586506296539818}}
      }
    }
  }
}
end

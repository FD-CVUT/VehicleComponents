"""
The four bus readers, `BusMotion`, `BusSlip`, `BusSlipAngle` and `BusWheelSpeed`, on one
`Sensors.CarBus` whose 22 fields each hold their own value: 1 to 22 in the connector's order
(vx = 1, vy = 2, r = 3, ax = 4, ay = 5, x = 6, y = 7, psi = 8, beta = 9, delta_sw = 10,
kappa_fl to kappa_rr = 11 to 14, alpha_fl to alpha_rr = 15 to 18, omega_fl to omega_rr = 19 to
22), set on this rig's own bus port. Each reader output must carry its own field, so a swapped or
misread field fails.
"""
test component BusReaders
  "Every field at its own value"
  bus = VehicleComponents.Sensors.CarBus() {}
  motion = VehicleComponents.Sensors.BusMotion() {
    "Dyad": {"placement": {"diagram": {"x1": 200, "x2": 100, "y1": 350, "y2": 450}}}
  }
  slips = VehicleComponents.Sensors.BusSlip() {
    "Dyad": {"placement": {"diagram": {"x1": 600, "x2": 700, "y1": 100, "y2": 200}}}
  }
  angles = VehicleComponents.Sensors.BusSlipAngle() {
    "Dyad": {"placement": {"diagram": {"x1": 550, "x2": 650, "y1": 350, "y2": 450}}}
  }
  speeds = VehicleComponents.Sensors.BusWheelSpeed() {
    "Dyad": {"placement": {"diagram": {"x1": 550, "x2": 650, "y1": 600, "y2": 700}}}
  }
relations
  connect(bus, motion.bus) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 500, "y": 400}], "E": 2}], "path": {}}}
  connect(bus, slips.bus) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 500, "y": 150}], "E": 2}], "path": {}}}
  connect(bus, angles.bus) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 500, "y": 400}], "E": 2}], "path": {}}}
  connect(bus, speeds.bus) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 500, "y": 650}], "E": 2}], "path": {}}}
  bus.vx = 1.0
  bus.vy = 2.0
  bus.r = 3.0
  bus.ax = 4.0
  bus.ay = 5.0
  bus.x = 6.0
  bus.y = 7.0
  bus.psi = 8.0
  bus.beta = 9.0
  bus.delta_sw = 10.0
  bus.kappa_fl = 11.0
  bus.kappa_fr = 12.0
  bus.kappa_rl = 13.0
  bus.kappa_rr = 14.0
  bus.alpha_fl = 15.0
  bus.alpha_fr = 16.0
  bus.alpha_rl = 17.0
  bus.alpha_rr = 18.0
  bus.omega_fl = 19.0
  bus.omega_fr = 20.0
  bus.omega_rl = 21.0
  bus.omega_rr = 22.0
metadata {
  "Dyad": {
    "tests": {
      "fields": {
        "stop": 1,
        "solver": "Auto",
        "abstol": 1e-8,
        "reltol": 1e-8,
        "atol": {
          "motion.delta_sw": 1e-12,
          "motion.r": 1e-12,
          "motion.vx": 1e-12,
          "motion.vy": 1e-12,
          "motion.beta": 1e-12,
          "motion.ax": 1e-12,
          "motion.ay": 1e-12,
          "motion.psi": 1e-12,
          "motion.x": 1e-12,
          "motion.y": 1e-12,
          "slips.kappa_fl": 1e-12,
          "slips.kappa_fr": 1e-12,
          "slips.kappa_rl": 1e-12,
          "slips.kappa_rr": 1e-12,
          "angles.alpha_fl": 1e-12,
          "angles.alpha_fr": 1e-12,
          "angles.alpha_rl": 1e-12,
          "angles.alpha_rr": 1e-12,
          "speeds.omega_fl": 1e-12,
          "speeds.omega_fr": 1e-12,
          "speeds.omega_rl": 1e-12,
          "speeds.omega_rr": 1e-12
        },
        "expect": {
          "final": {
            "motion.delta_sw": 10.0,
            "motion.r": 3.0,
            "motion.vx": 1.0,
            "motion.vy": 2.0,
            "motion.beta": 9.0,
            "motion.ax": 4.0,
            "motion.ay": 5.0,
            "motion.psi": 8.0,
            "motion.x": 6.0,
            "motion.y": 7.0,
            "slips.kappa_fl": 11.0,
            "slips.kappa_fr": 12.0,
            "slips.kappa_rl": 13.0,
            "slips.kappa_rr": 14.0,
            "angles.alpha_fl": 15.0,
            "angles.alpha_fr": 16.0,
            "angles.alpha_rl": 17.0,
            "angles.alpha_rr": 18.0,
            "speeds.omega_fl": 19.0,
            "speeds.omega_fr": 20.0,
            "speeds.omega_rl": 21.0,
            "speeds.omega_rr": 22.0
          }
        }
      }
    }
  }
}
end

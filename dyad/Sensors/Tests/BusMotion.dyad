"""
`BusMotion` reading a `Body.Planar.CarBus` whose 22 fields each hold their own value: 1 to 22 in the
connector's order (vx = 1, vy = 2, r = 3, ..., omega_rr = 22), set on this rig's own bus port. Each
output must carry its own field, so a swapped or misread field fails: delta_sw = 10, r = 3, vx = 1,
vy = 2, beta = 9, ax = 4, ay = 5, psi = 8, x = 6, y = 7.
"""
test component BusMotion
  "Every field at its own value"
  bus = VehicleComponents.Body.Planar.CarBus() {}
  reader = VehicleComponents.Sensors.BusMotion() {
    "Dyad": {
      "placement": {"diagram": {"x1": 450, "x2": 550, "y1": 400, "y2": 500, "rot": 270}}
    }
  }
relations
  connect(bus, reader.bus) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  bus.vx = 1.0
  bus.vy = 2.0
  bus.r = 3.0
  bus.ax = 4.0
  bus.ay = 5.0
  bus.x = 6.0
  bus.y = 7.0
  bus.psi = 8.0
  bus.beta = 9.0
  bus.delta_sw = 10.0
  bus.kappa_fl = 11.0
  bus.kappa_fr = 12.0
  bus.kappa_rl = 13.0
  bus.kappa_rr = 14.0
  bus.alpha_fl = 15.0
  bus.alpha_fr = 16.0
  bus.alpha_rl = 17.0
  bus.alpha_rr = 18.0
  bus.omega_fl = 19.0
  bus.omega_fr = 20.0
  bus.omega_rl = 21.0
  bus.omega_rr = 22.0
metadata {
  "Dyad": {
    "tests": {
      "fields": {
        "stop": 1,
        "solver": "Auto",
        "abstol": 1e-8,
        "reltol": 1e-8,
        "atol": {
          "reader.delta_sw": 1e-12,
          "reader.r": 1e-12,
          "reader.vx": 1e-12,
          "reader.vy": 1e-12,
          "reader.beta": 1e-12,
          "reader.ax": 1e-12,
          "reader.ay": 1e-12,
          "reader.psi": 1e-12,
          "reader.x": 1e-12,
          "reader.y": 1e-12
        },
        "expect": {
          "final": {
            "reader.delta_sw": 10.0,
            "reader.r": 3.0,
            "reader.vx": 1.0,
            "reader.vy": 2.0,
            "reader.beta": 9.0,
            "reader.ax": 4.0,
            "reader.ay": 5.0,
            "reader.psi": 8.0,
            "reader.x": 6.0,
            "reader.y": 7.0
          }
        }
      }
    }
  }
}
end

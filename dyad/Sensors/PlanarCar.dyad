"""
Ideal sensor cluster of the planar car: reads the chassis, the steering column and each wheel
through physical ports, without applying force or torque, and sends every reading on one
`Sensors.CarBus`.

The chassis readings are resolved in the chassis frame, except the position `x`, `y` and the
yaw angle `psi`, which are in the world frame. The body sideslip angle is
`beta = atan(vy / max(vx, 1 m/s))`. Each wheel's slip ratio, slip angle and spin speed come from
a `WheelSlip` on its center frame and shaft; `delta_sw` is the steering-wheel angle.

Ports: `chassis` the chassis frame; `steering` the steering-wheel shaft; `wheel_fl`, `wheel_fr`,
`wheel_rl`, `wheel_rr` the wheel centers; `spin_fl`, `spin_fr`, `spin_rl`, `spin_rr` the wheel
shafts; `bus` every reading (`Sensors.CarBus` lists the fields).

Assumptions: ideal, with no delay or noise. Below 1 m/s the sideslip is taken against 1 m/s, and
the wheel ratios against `WheelSlip`'s `v_eps`, which keeps them finite at standstill.
"""
component PlanarCar
  "Chassis frame"
  chassis = Frame2D() {"Dyad": {"placement": {"icon": {"x1": 650, "y1": -50, "x2": 750, "y2": 50}}}}
  "Steering-wheel shaft"
  steering = Spline() {"Dyad": {"placement": {"icon": {"x1": 250, "y1": -50, "x2": 350, "y2": 50}}}}
  "Front-left wheel center"
  wheel_fl = Frame2D() {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 250, "x2": 50, "y2": 350}}}}
  "Front-right wheel center"
  wheel_fr = Frame2D() {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 250, "x2": 1050, "y2": 350}}}}
  "Rear-left wheel center"
  wheel_rl = Frame2D() {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 550, "x2": 50, "y2": 650}}}}
  "Rear-right wheel center"
  wheel_rr = Frame2D() {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 550, "x2": 1050, "y2": 650}}}}
  "Front-left wheel shaft"
  spin_fl = Spline() {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 350, "x2": 50, "y2": 450}}}}
  "Front-right wheel shaft"
  spin_fr = Spline() {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 350, "x2": 1050, "y2": 450}}}}
  "Rear-left wheel shaft"
  spin_rl = Spline() {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 650, "x2": 50, "y2": 750}}}}
  "Rear-right wheel shaft"
  spin_rr = Spline() {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 650, "x2": 1050, "y2": 750}}}}
  "Every reading"
  bus = VehicleComponents.Sensors.CarBus() {"Dyad": {"placement": {"icon": {"x1": 450, "y1": 950, "x2": 550, "y2": 1050}}}}
  "Wheel rolling radius"
  parameter radius::Length = 0.31
  velocity = MultibodyComponents.PlanarMechanics.AbsoluteVelocity() {
    "Dyad": {"placement": {"diagram": {"x1": 550, "x2": 650, "y1": 200, "y2": 300}}}
  }
  acceleration = MultibodyComponents.PlanarMechanics.AbsoluteAcceleration() {
    "Dyad": {"placement": {"diagram": {"x1": 550, "x2": 650, "y1": 400, "y2": 500}}}
  }
  position = MultibodyComponents.PlanarMechanics.AbsolutePosition(resolve_in_frame = MultibodyComponents.ResolveInFrame.World()) {
    "Dyad": {"placement": {"diagram": {"x1": 550, "x2": 650, "y1": 600, "y2": 700}}}
  }
  steering_angle = RotationalComponents.Sensors.AngleSensor() {
    "Dyad": {
      "placement": {"diagram": {"x1": 250, "x2": 350, "y1": 150, "y2": 250, "rot": 90}}
    }
  }
  slip_fl = VehicleComponents.Sensors.WheelSlip(radius = radius) {
    "Dyad": {"placement": {"diagram": {"x1": 150, "x2": 250, "y1": 300, "y2": 400}}}
  }
  slip_fr = VehicleComponents.Sensors.WheelSlip(radius = radius) {
    "Dyad": {"placement": {"diagram": {"x1": 850, "x2": 750, "y1": 300, "y2": 400}}}
  }
  slip_rl = VehicleComponents.Sensors.WheelSlip(radius = radius) {
    "Dyad": {"placement": {"diagram": {"x1": 150, "x2": 250, "y1": 600, "y2": 700}}}
  }
  slip_rr = VehicleComponents.Sensors.WheelSlip(radius = radius) {
    "Dyad": {"placement": {"diagram": {"x1": 850, "x2": 750, "y1": 600, "y2": 700}}}
  }
relations
  connect(chassis, velocity.frame_a) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [{"x": 650, "y": 150}, {"x": 500, "y": 150}, {"x": 500, "y": 250}],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  connect(chassis, acceleration.frame_a) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [{"x": 650, "y": 100}, {"x": 500, "y": 100}, {"x": 500, "y": 450}],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  connect(chassis, position.frame_a) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [{"x": 650, "y": 100}, {"x": 450, "y": 100}, {"x": 450, "y": 650}],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  connect(steering, steering_angle.spline) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 350, "y": 100}, {"x": 300, "y": 100}], "E": 2}],
      "path": {}
    }
  }
  connect(wheel_fl, slip_fl.frame_a) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 100, "y": 300}, {"x": 100, "y": 330}], "E": 2}],
      "path": {}
    }
  }
  connect(wheel_fr, slip_fr.frame_a) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 900, "y": 300}, {"x": 900, "y": 330}], "E": 2}],
      "path": {}
    }
  }
  connect(wheel_rl, slip_rl.frame_a) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 100, "y": 600}, {"x": 100, "y": 630}], "E": 2}],
      "path": {}
    }
  }
  connect(wheel_rr, slip_rr.frame_a) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 900, "y": 600}, {"x": 900, "y": 630}], "E": 2}],
      "path": {}
    }
  }
  connect(spin_fl, slip_fl.spline) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 100, "y": 400}, {"x": 100, "y": 370}], "E": 2}],
      "path": {}
    }
  }
  connect(spin_fr, slip_fr.spline) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 900, "y": 400}, {"x": 900, "y": 370}], "E": 2}],
      "path": {}
    }
  }
  connect(spin_rl, slip_rl.spline) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 100, "y": 700}, {"x": 100, "y": 670}], "E": 2}],
      "path": {}
    }
  }
  connect(spin_rr, slip_rr.spline) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 900, "y": 700}, {"x": 900, "y": 670}], "E": 2}],
      "path": {}
    }
  }
  bus.vx = velocity.v_x
  bus.vy = velocity.v_y
  bus.r = velocity.w
  bus.ax = acceleration.a_x
  bus.ay = acceleration.a_y
  bus.x = position.x
  bus.y = position.y
  bus.psi = position.phi
  bus.beta = atan(velocity.v_y / max(velocity.v_x, 1.0))
  bus.delta_sw = steering_angle.phi
  bus.kappa_fl = slip_fl.kappa
  bus.kappa_fr = slip_fr.kappa
  bus.kappa_rl = slip_rl.kappa
  bus.kappa_rr = slip_rr.kappa
  bus.alpha_fl = slip_fl.alpha
  bus.alpha_fr = slip_fr.alpha
  bus.alpha_rl = slip_rl.alpha
  bus.alpha_rr = slip_rr.alpha
  bus.omega_fl = slip_fl.omega
  bus.omega_fr = slip_fr.omega
  bus.omega_rl = slip_rl.omega
  bus.omega_rr = slip_rr.omega
metadata {
  "Dyad": {"icons": {"default": "dyad://VehicleComponents/Sensors/PlanarCar.svg"}}
}
end

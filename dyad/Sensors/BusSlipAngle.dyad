"""
Bus reader for the planar car's tire slip angles: the four slip-angle fields of a
`Sensors.CarBusIn`, as plain signals.

Ports: `bus` the car's measurement bus; `alpha_fl`, `alpha_fr`, `alpha_rl`, `alpha_rr` each
wheel's slip angle [rad], positive when the wheel center moves to the left of its heading
(`WheelSlip` defines it).

Assumptions: none; each output is its bus field, with no delay or noise.
"""
component BusSlipAngle
  "The car's measurement bus"
  bus = VehicleComponents.Sensors.CarBusIn() {^bus}
  "Slip angle of the front-left wheel [rad]"
  alpha_fl = RealOutput() {^alpha_fl}
  "Slip angle of the front-right wheel [rad]"
  alpha_fr = RealOutput() {^alpha_fr}
  "Slip angle of the rear-left wheel [rad]"
  alpha_rl = RealOutput() {^alpha_rl}
  "Slip angle of the rear-right wheel [rad]"
  alpha_rr = RealOutput() {^alpha_rr}
relations
  alpha_fl = bus.alpha_fl
  alpha_fr = bus.alpha_fr
  alpha_rl = bus.alpha_rl
  alpha_rr = bus.alpha_rr
metadata {
  "Dyad": {"icons": {"default": "dyad://VehicleComponents/Sensors/BusSlipAngle.svg"}},
  "_links": {
    "bus": {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 450, "x2": 50, "y2": 550}}}},
    "alpha_fl": {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 150, "x2": 1050, "y2": 250}}}},
    "alpha_fr": {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 350, "x2": 1050, "y2": 450}}}},
    "alpha_rl": {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 550, "x2": 1050, "y2": 650}}}},
    "alpha_rr": {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 750, "x2": 1050, "y2": 850}}}}
  }
}
end

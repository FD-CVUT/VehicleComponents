"""
Target vehicle speed from a drive cycle: a time-series CSV of time and speed in km/h.

Port: `y`, the target vehicle speed in km/h. The default is the packaged WLTC class 3b trace
(Regulation (EU) 2017/1151). Linear interpolation follows the prescribed straight ramps between
its 1 Hz points, and constant extrapolation keeps the endpoint defined.
"""
component DriveCycle
  "Target vehicle speed [km/h]"
  y = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 950, "x2": 1050, "y1": 450, "y2": 550}}}}
  "CSV with `t_s` and `v_kmh` columns"
  structural parameter file::String = "dyad://VehicleComponents/data/drive_cycles/wltc_class3b.csv"
  structural parameter dataset::DyadData.DyadTimeseries = DyadData.DyadTimeseries(file, independent_var = "t_s", dependent_vars = ["v_kmh"])
  clock = BlockComponents.Sources.ContinuousClock() {
    "Dyad": {"placement": {"diagram": {"x1": 100, "x2": 200, "y1": 450, "y2": 550}}}
  }
  interpolation = BlockComponents.Tables.Interpolation(dataset = dataset, interpolation_type = BlockComponents.Tables.InterpolationType.LinearInterpolation(), extrapolation_type = BlockComponents.Tables.ExtrapolationType.Constant()) {
    "Dyad": {"placement": {"diagram": {"x1": 350, "x2": 500, "y1": 450, "y2": 600}}}
  }
relations
  connect(clock.y, interpolation.u) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 300, "y": 500}, {"x": 300, "y": 525}], "E": 2}],
      "path": {}
    }
  }
  connect(interpolation.y, y) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 550, "y": 525}, {"x": 550, "y": 500}], "E": 2}],
      "path": {}
    }
  }
metadata {
  "Dyad": {"icons": {"default": "dyad://VehicleComponents/Driver/DriveCycle.svg"}}
}
end

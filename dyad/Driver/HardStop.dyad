"Full throttle until 9 s, coast, then full braking from 19 s. Ports are those of `Driver.Interface`."
component HardStop
  extends VehicleComponents.Driver.Scripted(table = "dyad://VehicleComponents/data/drivers/hard_stop.csv")
metadata {
  "Dyad": {
    "icons": {"default": "dyad://VehicleComponents/Driver/HardStop.svg"},
    "labels": [{"label": "$(instance)", "x": 500, "y": 1100, "rot": 0}]
  }
}
end

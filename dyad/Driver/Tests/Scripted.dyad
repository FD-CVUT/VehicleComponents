"""
The two presets read their tables: `CoastDown` holds full throttle until 9 s and then coasts;
`HardStop` coasts the same way and brakes fully from 19 s. Neither steers, so steering stays 0 rad.

`between_ticks` plays `tests/steer_step.csv`, which is all zero until a row at 0.105 s sets
throttle 0.25 and steering 0.1 rad. That breakpoint lies between the 10 ms ticks at 0.10 s and
0.11 s. Unclocked playback takes the row at its own time, so at 0.107 s, before the next tick,
throttle is 0.25 and steering 0.1 rad; a driver sampled every 10 ms would still hold the 0.10 s
values, 0 and 0. Brake stays 0 throughout.
"""
test component Scripted
  coast = VehicleComponents.Driver.CoastDown() {
    "Dyad": {"placement": {"diagram": {"x1": 200, "x2": 300, "y1": 200, "y2": 300}}}
  }
  stop = VehicleComponents.Driver.HardStop() {
    "Dyad": {"placement": {"diagram": {"x1": 200, "x2": 300, "y1": 450, "y2": 550}}}
  }
  step = VehicleComponents.Driver.Scripted(table = "dyad://VehicleComponents/data/drivers/tests/steer_step.csv") {
    "Dyad": {"placement": {"diagram": {"x1": 200, "x2": 300, "y1": 700, "y2": 800}}}
  }
relations
metadata {
  "Dyad": {
    "tests": {
      "coast_down": {
        "stop": 12,
        "solver": "Auto",
        "abstol": 1e-6,
        "reltol": 1e-6,
        "atol": {
          "coast.throttle_signal": 1e-9,
          "coast.brake_signal": 1e-9,
          "coast.steer_signal": 1e-9
        },
        "expect": {
          "initial": {"coast.throttle_signal": 1, "coast.brake_signal": 0, "coast.steer_signal": 0},
          "final": {"coast.throttle_signal": 0, "coast.brake_signal": 0, "coast.steer_signal": 0},
          "signals": ["coast.throttle_signal"]
        }
      },
      "hard_stop": {
        "stop": 20,
        "solver": "Auto",
        "abstol": 1e-6,
        "reltol": 1e-6,
        "atol": {
          "stop.throttle_signal": 1e-9,
          "stop.brake_signal": 1e-9,
          "stop.steer_signal": 1e-9
        },
        "expect": {
          "initial": {"stop.throttle_signal": 1, "stop.brake_signal": 0, "stop.steer_signal": 0},
          "final": {"stop.throttle_signal": 0, "stop.brake_signal": 1, "stop.steer_signal": 0},
          "signals": ["stop.throttle_signal", "stop.brake_signal"]
        }
      },
      "between_ticks": {
        "stop": 0.107,
        "solver": "Auto",
        "abstol": 1e-6,
        "reltol": 1e-6,
        "atol": {
          "step.throttle_signal": 1e-9,
          "step.brake_signal": 1e-9,
          "step.steer_signal": 1e-9
        },
        "expect": {
          "initial": {"step.throttle_signal": 0, "step.brake_signal": 0, "step.steer_signal": 0},
          "final": {"step.throttle_signal": 0.25, "step.brake_signal": 0, "step.steer_signal": 0.1}
        }
      }
    }
  }
}
end

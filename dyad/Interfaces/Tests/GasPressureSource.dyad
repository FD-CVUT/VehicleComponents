"""
A `GasPressureSource` holding 30 kPa absolute on the vacuum hose of a default
`Chassis.Brakes.VacuumBooster` at rest: no force on the input rod, the output rod held at its rest
position s_rest = 2.5e-3 m, so the chamber volumes do not change. The chambers start at 33 kPa.

At rest the input force is 0, below the 40 N cut-in, so the vacuum valve is fully open and joins
the rear chamber to the front one; the atmospheric valve is shut. Air leaks into the front
chamber, C_leak (p_atm - p_f), and leaves through the check valve, C_vm (p_f - 30000), so the
chambers settle where the two balance:

    p_f = (C_vm 30000 + C_leak p_atm)/(C_vm + C_leak)
        = (1.26e-7 · 30000 + 1.4e-10 · 101325)/(1.26e-7 + 1.4e-10) = 30079.162 Pa

and the rear chamber, with no flow left between them, at the same pressure. The source takes the
check valve's flow through the hose, 1.26e-7 · 79.162 = 9.97442e-6 kg/s, the air the leak lets
in. The chambers drain through the check valve with a time constant of about
(V_f0 + V_r0)/(R T C_vm) = 2.83e-3/(287.05 · 298.15 · 1.26e-7) = 0.26 s, so by 5 s they are
within e^-19 of the balance.
"""
test component GasPressureSource
  "Source pressure, absolute"
  pressure = BlockComponents.Sources.Constant(k = 30e3) {
    "Dyad": {"placement": {"diagram": {"x1": 200, "x2": 300, "y1": 200, "y2": 300}}}
  }
  source = VehicleComponents.Interfaces.GasPressureSource() {
    "Dyad": {"placement": {"diagram": {"x1": 450, "x2": 550, "y1": 200, "y2": 300}}}
  }
  booster = VehicleComponents.Chassis.Brakes.VacuumBooster() {
    "Dyad": {"placement": {"diagram": {"x1": 700, "x2": 800, "y1": 200, "y2": 300}}}
  }
  "Output rod held at its rest position"
  rod = TranslationalComponents.Components.Fixed(s0 = 2.5e-3) {
    "Dyad": {
      "placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 200, "y2": 300, "rot": 270}}
    }
  }
  housing = TranslationalComponents.Components.Fixed() {
    "Dyad": {"placement": {"diagram": {"x1": 700, "x2": 800, "y1": 450, "y2": 550}}}
  }
relations
  connect(pressure.y, source.p) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(source.port, booster.vacuum) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [{"x": 650, "y": 250}, {"x": 650, "y": 150}, {"x": 725, "y": 150}],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  connect(booster.rod_out, rod.flange) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(booster.support, housing.flange) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
metadata {
  "Dyad": {
    "tests": {
      "drain": {
        "stop": 5,
        "solver": "Auto",
        "abstol": 1e-8,
        "reltol": 1e-10,
        "atol": {"booster.p_f": 0.01, "booster.p_r": 0.01, "source.port.mdot": 1e-10},
        "expect": {
          "final": {
            "booster.p_f": 30079.162,
            "booster.p_r": 30079.162,
            "source.port.mdot": 9.97442e-6
          }
        }
      }
    }
  }
}
end

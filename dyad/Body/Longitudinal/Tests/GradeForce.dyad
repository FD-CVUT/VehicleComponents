"""
A 1400 kg mass at rest on a flat road that turns into a 10 % climb at t = 1 s.

Before the step the force is 0. After it the along-slope weight is
m g sin(atan(0.1)) = 13729.31 · 0.0995037 = 1366.1174 N, which decelerates the mass at
-1366.1174/1400 = -0.975798 m/s². Over the 4 s of climb to t = 5 s the mass reaches
-0.975798 · 4 = -3.90319 m/s.
"""
test component GradeForce
  grade = BlockComponents.Sources.Step(height = 0.10, offset = 0.0, start_time = 1.0) {
    "Dyad": {"placement": {"diagram": {"x1": 200, "x2": 300, "y1": 200, "y2": 300}}}
  }
  force = VehicleComponents.Body.Longitudinal.GradeForce(m = 1400.0) {
    "Dyad": {"placement": {"diagram": {"x1": 450, "x2": 550, "y1": 200, "y2": 300}}}
  }
  mass = TranslationalComponents.Components.Mass(m = 1400.0, s = initial 0.0, v = initial 0.0) {
    "Dyad": {"placement": {"diagram": {"x1": 700, "x2": 800, "y1": 200, "y2": 300}}}
  }
  fixed = TranslationalComponents.Components.Fixed() {
    "Dyad": {"placement": {"diagram": {"x1": 450, "x2": 550, "y1": 450, "y2": 550}}}
  }
relations
  connect(grade.y, force.grade) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(force.flange, mass.flange_a) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(force.support, fixed.flange) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
metadata {
  "Dyad": {
    "tests": {
      "climb_from_flat": {
        "stop": 5,
        "solver": "Auto",
        "abstol": 1e-6,
        "reltol": 1e-6,
        "atol": {"force.f": 0.01, "mass.a": 0.0001, "mass.v": 0.001},
        "expect": {
          "initial": {"force.f": 0, "mass.a": 0, "mass.v": 0},
          "final": {"force.f": 1366.1174, "mass.a": -0.975798, "mass.v": -3.90319}
        }
      }
    }
  }
}
end
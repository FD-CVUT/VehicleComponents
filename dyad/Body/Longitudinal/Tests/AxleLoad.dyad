"""
A 1400 kg mass pushed by 2800 N accelerates at 2 m/s². The driven axle starts at its static share
0.55 m g = 7551.12 N and, once the body has pitched, carries m a h/L = 476 N more. `axle` has
nothing on its downforce flange; `aero` is pressed down with 1000 N, of which 0.55 lands on the
axle. Both push their load onto a fixed road.
"""
test component AxleLoad
  traction = TranslationalComponents.Sources.ConstantForce(f_constant = 2800.0) {
    "Dyad": {"placement": {"diagram": {"x1": 450, "x2": 550, "y1": 350, "y2": 450}}}
  }
  mass = TranslationalComponents.Components.Mass(m = 1400.0) {
    "Dyad": {"placement": {"diagram": {"x1": 850, "x2": 950, "y1": 200, "y2": 300}}}
  }
  fixed = TranslationalComponents.Components.Fixed() {
    "Dyad": {
      "placement": {"diagram": {"x1": 200, "x2": 300, "y1": 450, "y2": 550, "rot": 90}}
    }
  }
  axle = VehicleComponents.Body.Longitudinal.AxleLoad(m = 1400.0) {
    "Dyad": {
      "placement": {"diagram": {"x1": 850, "x2": 950, "y1": 450, "y2": 550, "rot": 180}}
    }
  }
  road = TranslationalComponents.Components.Fixed() {
    "Dyad": {
      "placement": {"diagram": {"x1": 1100, "x2": 1200, "y1": 350, "y2": 450, "rot": 270}}
    }
  }
  downforce = TranslationalComponents.Sources.ConstantForce(f_constant = 1000.0) {
    "Dyad": {
      "placement": {"diagram": {"x1": 1100, "x2": 1200, "y1": 600, "y2": 700, "rot": 270}}
    }
  }
  aero = VehicleComponents.Body.Longitudinal.AxleLoad(m = 1400.0) {
    "Dyad": {
      "placement": {"diagram": {"x1": 950, "x2": 850, "y1": 700, "y2": 800, "rot": 90}}
    }
  }
  aero_road = TranslationalComponents.Components.Fixed() {
    "Dyad": {
      "placement": {"diagram": {"x1": 1500, "x2": 1600, "y1": 600, "y2": 700, "rot": 270}}
    }
  }
relations
  connect(traction.flange, mass.flange_a, axle.flange, aero.flange) {
    "Dyad": {
      "edges": [
        {"S": 1, "M": [], "E": -1},
        {"S": 2, "M": [{"x": 700, "y": 500}], "E": -1},
        {"S": 3, "M": [{"x": 700, "y": 250}], "E": -1},
        {"S": 4, "M": [{"x": 900, "y": 650}, {"x": 700, "y": 650}], "E": -1}
      ],
      "junctions": [{"x": 700, "y": 400}],
      "path": {}
    }
  }
  connect(traction.support, fixed.flange) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 500, "y": 500}], "E": 2}], "path": {}}}
  connect(axle.load, road.flange) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 880.0000000000001, "y": 400}], "E": 2}],
      "path": {}
    }
  }
  connect(aero.load, aero_road.flange, downforce.support) {
    "Dyad": {
      "edges": [
        {"S": 1, "M": [], "E": -1},
        {"S": 2, "M": [], "E": -1},
        {
          "S": 3,
          "M": [{"x": 800, "y": 730}, {"x": 800, "y": 850}, {"x": 1350, "y": 850}],
          "E": -1
        }
      ],
      "junctions": [{"x": 1350, "y": 650}],
      "path": {}
    }
  }
  connect(downforce.flange, aero.downforce) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [{"x": 1150, "y": 550}, {"x": 1050, "y": 550}, {"x": 1050, "y": 750}],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  initial mass.s = 0.0
  initial mass.v = 0.0
  initial axle.a_pitch = 0.0
  initial aero.a_pitch = 0.0
metadata {
  "Dyad": {
    "tests": {
      "launch": {
        "stop": 2,
        "solver": "Auto",
        "abstol": 1e-6,
        "reltol": 1e-6,
        "atol": {"axle.F_z": 0.01, "aero.F_z": 0.01, "road.flange.f": 0.01},
        "expect": {
          "initial": {"axle.F_z": 7551.1205, "aero.F_z": 8101.1205},
          "final": {"axle.F_z": 8027.1205, "aero.F_z": 8577.1205, "road.flange.f": 8027.1205},
          "signals": ["axle.F_z"]
        }
      }
    }
  }
}
end

"""
500 N of traction on two bodies: `flat` from rest on a 0 grade, and `climbing`
at 10 m/s on a 2 % grade. On the flat the start acceleration is 500/1400 = 0.3571 m/s² and the
speed settles where drag and rolling resistance take the whole 500 N. On the climb the road load
at 10 m/s is 477.05 N, leaving 0.0164 m/s².
"""
test component Vehicle
  flat_traction = TranslationalComponents.Sources.ConstantForce(f_constant = 500.0) {
    "Dyad": {"placement": {"diagram": {"x1": 850, "x2": 750, "y1": 350, "y2": 450}}}
  }
  level = BlockComponents.Sources.Constant(k = 0.0) {
    "Dyad": {"placement": {"diagram": {"x1": 250, "x2": 350, "y1": 200, "y2": 300}}}
  }
  "Car tire on asphalt"
  tire = BlockComponents.Sources.Constant(k = 0.012) {
    "Dyad": {"placement": {"diagram": {"x1": 200, "x2": 300, "y1": 450, "y2": 550}}}
  }
  flat = VehicleComponents.Body.Longitudinal.Vehicle() {
    "Dyad": {"placement": {"diagram": {"x1": 500, "x2": 600, "y1": 350, "y2": 450}}}
  }
  climb_traction = TranslationalComponents.Sources.ConstantForce(f_constant = 500.0) {
    "Dyad": {
      "placement": {"diagram": {"x1": 850, "x2": 950, "y1": 700, "y2": 800, "rot": 180}}
    }
  }
  grade = BlockComponents.Sources.Constant(k = 0.02) {
    "Dyad": {"placement": {"diagram": {"x1": 250, "x2": 350, "y1": 700, "y2": 800}}}
  }
  climbing = VehicleComponents.Body.Longitudinal.Vehicle(mass(v = initial 10.0)) {
    "Dyad": {"placement": {"diagram": {"x1": 500, "x2": 600, "y1": 700, "y2": 800}}}
  }
  fixed = TranslationalComponents.Components.Fixed() {
    "Dyad": {
      "placement": {"diagram": {"x1": 1000, "x2": 1100, "y1": 450, "y2": 550, "rot": 270}}
    }
  }
relations
  connect(flat_traction.flange, flat.flange) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(climb_traction.flange, climbing.flange) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(flat_traction.support, climb_traction.support) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 800, "y": 650}, {"x": 900, "y": 650}], "E": 2}],
      "path": {}
    }
  }
  connect(flat_traction.support, fixed.flange) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 800, "y": 500}], "E": 2}], "path": {}}}
  connect(grade.y, climbing.grade) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(level.y, flat.grade) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [
            {"x": 400, "y": 250},
            {"x": 400, "y": 450},
            {"x": 450, "y": 450},
            {"x": 450, "y": 400}
          ],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  connect(tire.y, flat.f_r) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [
            {"x": 350, "y": 500},
            {"x": 350, "y": 400},
            {"x": 150, "y": 400},
            {"x": 150, "y": 100},
            {"x": 450, "y": 100},
            {"x": 450, "y": 375}
          ],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  connect(tire.y, climbing.f_r) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 450, "y": 500}, {"x": 450, "y": 725}], "E": 2}],
      "path": {}
    }
  }
metadata {
  "Dyad": {
    "tests": {
      "flat_from_rest": {
        "stop": 800,
        "solver": "Auto",
        "abstol": 1e-6,
        "reltol": 1e-6,
        "atol": {"flat.mass.a": 0.001, "flat.mass.v": 0.001},
        "expect": {
          "initial": {"flat.mass.a": 0.35714285714285715, "flat.mass.v": 0},
          "final": {"flat.mass.a": 0, "flat.mass.v": 29.780869893947216},
          "signals": ["flat.mass.v"]
        }
      },
      "climb": {
        "stop": 10,
        "solver": "Auto",
        "abstol": 1e-6,
        "reltol": 1e-6,
        "atol": {"climbing.mass.a": 0.001, "climbing.mass.v": 0.001},
        "expect": {
          "initial": {"climbing.mass.a": 0.0163928, "climbing.mass.v": 10},
          "final": {"climbing.mass.v": 10.15956},
          "signals": ["climbing.mass.v"]
        }
      }
    }
  }
}
end

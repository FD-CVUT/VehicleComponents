"""
500 N of traction on two bodies: `flat` from rest on a 0 grade, and `climbing`
at 10 m/s on a 2 % grade. On the flat the start acceleration is 500/1400 = 0.3571 m/s² and the
speed settles where drag and rolling resistance take the whole 500 N. On the climb the road load
at 10 m/s is 477.05 N, leaving 0.0164 m/s².
"""
test component Vehicle
  flat_traction = TranslationalComponents.Sources.ConstantForce(f_constant = 500.0) {
    "Dyad": {
      "placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 300, "y2": 400, "rot": 180}}
    }
  }
  level = BlockComponents.Sources.Constant(k = 0.0) {
    "Dyad": {"placement": {"diagram": {"x1": 450, "x2": 550, "y1": 200, "y2": 300}}}
  }
  "Car tire on asphalt"
  tire = BlockComponents.Sources.Constant(k = 0.012) {
    "Dyad": {"placement": {"diagram": {"x1": 200, "x2": 300, "y1": 400, "y2": 500}}}
  }
  flat = VehicleComponents.Body.Longitudinal.Vehicle() {
    "Dyad": {"placement": {"diagram": {"x1": 700, "x2": 800, "y1": 300, "y2": 400}}}
  }
  climb_traction = TranslationalComponents.Sources.ConstantForce(f_constant = 500.0) {
    "Dyad": {
      "placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 550, "y2": 650, "rot": 270}}
    }
  }
  grade = BlockComponents.Sources.Constant(k = 0.02) {
    "Dyad": {"placement": {"diagram": {"x1": 450, "x2": 550, "y1": 600, "y2": 700}}}
  }
  climbing = VehicleComponents.Body.Longitudinal.Vehicle() {
    "Dyad": {"placement": {"diagram": {"x1": 700, "x2": 800, "y1": 600, "y2": 700}}}
  }
  fixed = TranslationalComponents.Components.Fixed() {
    "Dyad": {
      "placement": {"diagram": {"x1": 1350, "x2": 1450, "y1": 450, "y2": 550, "rot": 270}}
    }
  }
relations
  connect(flat_traction.flange, flat.flange) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(climb_traction.flange, climbing.flange) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [{"x": 1000, "y": 500}, {"x": 850, "y": 500}, {"x": 850, "y": 650}],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  connect(flat_traction.support, climb_traction.support, fixed.flange) {
    "Dyad": {
      "edges": [
        {"S": 1, "M": [], "E": -1},
        {"S": 2, "M": [{"x": 1200, "y": 600}], "E": -1},
        {"S": 3, "M": [{"x": 1000, "y": 250}, {"x": 1200, "y": 250}], "E": -1}
      ],
      "junctions": [{"x": 1200, "y": 500}],
      "path": {}
    }
  }
  connect(grade.y, climbing.grade) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(level.y, flat.grade) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [
            {"x": 600, "y": 250},
            {"x": 600, "y": 400},
            {"x": 650, "y": 400},
            {"x": 650, "y": 350}
          ],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  connect(tire.y, flat.f_r, climbing.f_r) {
    "Dyad": {
      "edges": [
        {"S": 1, "M": [], "E": -1},
        {
          "S": 2,
          "M": [
            {"x": 650, "y": 325},
            {"x": 650, "y": 150},
            {"x": 400, "y": 150},
            {"x": 400, "y": 450}
          ],
          "E": -1
        },
        {"S": 3, "M": [{"x": 650, "y": 625}, {"x": 650, "y": 450}], "E": -1}
      ],
      "junctions": [{"x": 450, "y": 450}],
      "path": {}
    }
  }
  initial flat.mass.s = 0.0
  initial flat.mass.v = 0.0
  initial climbing.mass.s = 0.0
  initial climbing.mass.v = 10.0
metadata {
  "Dyad": {
    "tests": {
      "flat_from_rest": {
        "stop": 800,
        "solver": "Auto",
        "abstol": 1e-6,
        "reltol": 1e-6,
        "atol": {"flat.mass.a": 0.001, "flat.mass.v": 0.001},
        "expect": {
          "initial": {"flat.mass.a": 0.35714285714285715, "flat.mass.v": 0},
          "final": {"flat.mass.a": 0, "flat.mass.v": 29.780869893947216},
          "signals": ["flat.mass.v"]
        }
      },
      "climb": {
        "stop": 10,
        "solver": "Auto",
        "abstol": 1e-6,
        "reltol": 1e-6,
        "atol": {"climbing.mass.a": 0.001, "climbing.mass.v": 0.001},
        "expect": {
          "initial": {"climbing.mass.a": 0.0163928, "climbing.mass.v": 10},
          "final": {"climbing.mass.v": 10.15956},
          "signals": ["climbing.mass.v"]
        }
      }
    }
  }
}
end

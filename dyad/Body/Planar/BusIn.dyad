"""
Packs the planar car's measurements into one `CarBus`: each input passes unchanged to the bus
field of the same name.

Ports: one input per `CarBus` field, in the connector's order down the left side (`CarBus` lists
the fields and their units); `bus` the packed bus. Every input must be wired.

Assumptions: none; the bus carries each signal with no delay or noise.
"""
component BusIn
  "Forward speed of the chassis, in the chassis frame [m/s]"
  vx = RealInput() {"Dyad": {"placement": {"icon": {"x1": -40, "y1": 62, "x2": 40, "y2": 98}}}}
  "Lateral speed of the chassis, in the chassis frame [m/s]"
  vy = RealInput() {"Dyad": {"placement": {"icon": {"x1": -40, "y1": 102, "x2": 40, "y2": 138}}}}
  "Yaw rate [rad/s]"
  r = RealInput() {"Dyad": {"placement": {"icon": {"x1": -40, "y1": 142, "x2": 40, "y2": 178}}}}
  "Forward acceleration, in the chassis frame [m/s²]"
  ax = RealInput() {"Dyad": {"placement": {"icon": {"x1": -40, "y1": 182, "x2": 40, "y2": 218}}}}
  "Lateral acceleration, in the chassis frame [m/s²]"
  ay = RealInput() {"Dyad": {"placement": {"icon": {"x1": -40, "y1": 222, "x2": 40, "y2": 258}}}}
  "World x position of the chassis frame [m]"
  x = RealInput() {"Dyad": {"placement": {"icon": {"x1": -40, "y1": 262, "x2": 40, "y2": 298}}}}
  "World y position of the chassis frame [m]"
  y = RealInput() {"Dyad": {"placement": {"icon": {"x1": -40, "y1": 302, "x2": 40, "y2": 338}}}}
  "Yaw angle [rad]"
  psi = RealInput() {"Dyad": {"placement": {"icon": {"x1": -40, "y1": 342, "x2": 40, "y2": 378}}}}
  "Body sideslip angle, atan(vy / max(|vx|, 1 m/s)) [rad]"
  beta = RealInput() {"Dyad": {"placement": {"icon": {"x1": -40, "y1": 382, "x2": 40, "y2": 418}}}}
  "Steering-wheel angle [rad]"
  delta_sw = RealInput() {"Dyad": {"placement": {"icon": {"x1": -40, "y1": 422, "x2": 40, "y2": 458}}}}
  "Longitudinal slip of the front-left wheel [-]"
  kappa_fl = RealInput() {"Dyad": {"placement": {"icon": {"x1": -40, "y1": 462, "x2": 40, "y2": 498}}}}
  "Longitudinal slip of the front-right wheel [-]"
  kappa_fr = RealInput() {"Dyad": {"placement": {"icon": {"x1": -40, "y1": 502, "x2": 40, "y2": 538}}}}
  "Longitudinal slip of the rear-left wheel [-]"
  kappa_rl = RealInput() {"Dyad": {"placement": {"icon": {"x1": -40, "y1": 542, "x2": 40, "y2": 578}}}}
  "Longitudinal slip of the rear-right wheel [-]"
  kappa_rr = RealInput() {"Dyad": {"placement": {"icon": {"x1": -40, "y1": 582, "x2": 40, "y2": 618}}}}
  "Slip angle of the front-left wheel [rad]"
  alpha_fl = RealInput() {"Dyad": {"placement": {"icon": {"x1": -40, "y1": 622, "x2": 40, "y2": 658}}}}
  "Slip angle of the front-right wheel [rad]"
  alpha_fr = RealInput() {"Dyad": {"placement": {"icon": {"x1": -40, "y1": 662, "x2": 40, "y2": 698}}}}
  "Slip angle of the rear-left wheel [rad]"
  alpha_rl = RealInput() {"Dyad": {"placement": {"icon": {"x1": -40, "y1": 702, "x2": 40, "y2": 738}}}}
  "Slip angle of the rear-right wheel [rad]"
  alpha_rr = RealInput() {"Dyad": {"placement": {"icon": {"x1": -40, "y1": 742, "x2": 40, "y2": 778}}}}
  "Spin speed of the front-left wheel [rad/s]"
  omega_fl = RealInput() {"Dyad": {"placement": {"icon": {"x1": -40, "y1": 782, "x2": 40, "y2": 818}}}}
  "Spin speed of the front-right wheel [rad/s]"
  omega_fr = RealInput() {"Dyad": {"placement": {"icon": {"x1": -40, "y1": 822, "x2": 40, "y2": 858}}}}
  "Spin speed of the rear-left wheel [rad/s]"
  omega_rl = RealInput() {"Dyad": {"placement": {"icon": {"x1": -40, "y1": 862, "x2": 40, "y2": 898}}}}
  "Spin speed of the rear-right wheel [rad/s]"
  omega_rr = RealInput() {"Dyad": {"placement": {"icon": {"x1": -40, "y1": 902, "x2": 40, "y2": 938}}}}
  "Every field, packed"
  bus = VehicleComponents.Body.Planar.CarBus() {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 450, "x2": 1050, "y2": 550}}}}
relations
  bus.vx = vx
  bus.vy = vy
  bus.r = r
  bus.ax = ax
  bus.ay = ay
  bus.x = x
  bus.y = y
  bus.psi = psi
  bus.beta = beta
  bus.delta_sw = delta_sw
  bus.kappa_fl = kappa_fl
  bus.kappa_fr = kappa_fr
  bus.kappa_rl = kappa_rl
  bus.kappa_rr = kappa_rr
  bus.alpha_fl = alpha_fl
  bus.alpha_fr = alpha_fr
  bus.alpha_rl = alpha_rl
  bus.alpha_rr = alpha_rr
  bus.omega_fl = omega_fl
  bus.omega_fr = omega_fr
  bus.omega_rl = omega_rl
  bus.omega_rr = omega_rr
metadata {
  "Dyad": {"icons": {"default": "dyad://VehicleComponents/Body/Planar/BusIn.svg"}}
}
end

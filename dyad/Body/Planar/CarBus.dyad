"""
The planar car's measurement bus, as the car sends it: every signal measured about the car, on
one port, each field in its own unit (SI; the slip ratios dimensionless). It is a plain signal
bus, not a model of a vehicle network.

A `CarBus` connects to a `CarBusIn`, field by field, or passes out through the `CarBus` port of
the component that holds it. Two `CarBus` ports side by side would both drive the same signals,
and the compiler does not reject that wiring.
"""
connector CarBus
  "Forward speed of the chassis, in the chassis frame"
  output vx::Velocity
  "Lateral speed of the chassis, in the chassis frame"
  output vy::Velocity
  "Yaw rate"
  output r::AngularVelocity
  "Forward acceleration, in the chassis frame"
  output ax::Acceleration
  "Lateral acceleration, in the chassis frame"
  output ay::Acceleration
  "World x position of the chassis frame"
  output x::Position
  "World y position of the chassis frame"
  output y::Position
  "Yaw angle"
  output psi::Angle
  "Body sideslip angle, atan(vy / max(|vx|, 1 m/s))"
  output beta::Angle
  "Steering-wheel angle"
  output delta_sw::Angle
  "Longitudinal slip of the front-left wheel"
  output kappa_fl::Real
  "Longitudinal slip of the front-right wheel"
  output kappa_fr::Real
  "Longitudinal slip of the rear-left wheel"
  output kappa_rl::Real
  "Longitudinal slip of the rear-right wheel"
  output kappa_rr::Real
  "Slip angle of the front-left wheel"
  output alpha_fl::Angle
  "Slip angle of the front-right wheel"
  output alpha_fr::Angle
  "Slip angle of the rear-left wheel"
  output alpha_rl::Angle
  "Slip angle of the rear-right wheel"
  output alpha_rr::Angle
  "Spin speed of the front-left wheel"
  output omega_fl::AngularVelocity
  "Spin speed of the front-right wheel"
  output omega_fr::AngularVelocity
  "Spin speed of the rear-left wheel"
  output omega_rl::AngularVelocity
  "Spin speed of the rear-right wheel"
  output omega_rr::AngularVelocity
metadata {
  "Dyad": {
    "icons": {"default": "dyad://VehicleComponents/Body/Planar/CarBus.svg"},
    "path": {"stroke": "#0277bd"}
  }
}
end

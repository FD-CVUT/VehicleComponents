"""
`Sideslip` fed constant chassis speeds: 19.363634 m/s forward and -6.503820 m/s to the left, the
motion of a car heading 0.7 rad off a world velocity of (19, 7.5) m/s.

- `forward`: beta = atan(-6.503820/max(19.363634, 1)) = atan(-0.335875) = -0.324039 rad.
- `reverse`: the same car driving backward, vx = -19.363634 m/s and vy = 6.503820 m/s. The angle
  is taken against |vx|: beta = atan(6.503820/19.363634) = 0.324039 rad, where vx in place of
  |vx| would floor the denominator at 1 m/s and give atan(6.503820) = 1.418235 rad.
"""
test component Sideslip
  "Forward speed"
  parameter vx::Velocity = 19.363634
  "Lateral speed"
  parameter vy::Velocity = -6.50382
  forward = BlockComponents.Sources.Constant(k = vx) {
    "Dyad": {
      "placement": {"diagram": {"x1": 200, "x2": 300, "y1": 200, "y2": 300, "rot": 90}}
    }
  }
  sideways = BlockComponents.Sources.Constant(k = vy) {
    "Dyad": {"placement": {"diagram": {"x1": 300, "x2": 400, "y1": 450, "y2": 550}}}
  }
  sideslip = VehicleComponents.Body.Planar.Helpers.Sideslip() {
    "Dyad": {"placement": {"diagram": {"x1": 550, "x2": 650, "y1": 550, "y2": 650}}}
  }
relations
  connect(forward.y, sideslip.vx) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [{"x": 250, "y": 600}, {"x": 500, "y": 600}, {"x": 500, "y": 620}],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  connect(sideways.y, sideslip.vy) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 500, "y": 500}, {"x": 500, "y": 580}], "E": 2}],
      "path": {}
    }
  }
metadata {
  "Dyad": {
    "tests": {
      "forward": {
        "stop": 1,
        "solver": "Auto",
        "abstol": 1e-8,
        "reltol": 1e-8,
        "atol": {"sideslip.beta": 1e-6},
        "expect": {"final": {"sideslip.beta": -0.324039}}
      },
      "reverse": {
        "stop": 1,
        "solver": "Auto",
        "abstol": 1e-8,
        "reltol": 1e-8,
        "params": {"vx": -19.363634, "vy": 6.50382},
        "atol": {"sideslip.beta": 1e-6},
        "expect": {"final": {"sideslip.beta": 0.324039}}
      }
    }
  }
}
end

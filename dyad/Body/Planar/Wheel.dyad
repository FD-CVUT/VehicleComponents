"""
Road wheel of the planar car: slip tire contact and rotating inertia, wired in the order torque
travels from the road: tire, inertia, shaft.

Ports:
- `frame_a` the wheel center, with x along the wheel heading; it takes the tire force.
- `spin` the wheel shaft, where a brake or a drive attaches; open when nothing acts on the wheel.
- `load` takes the normal load; `SlipWheelJoint` states the load-flange convention.

The tire is a `SlipWheelJoint` whose `mu_scale` comes from a `RoadGrip` at the wheel center, so
the grip follows the wheel over the road `grip`, a `Road.Grip` built with `Road.grip(file)`; the
default is the uniform road of grip 1.

Documented variables: `F_x` and `F_y` are the longitudinal and lateral tire forces on the
vehicle, in the wheel's heading frame, and `F_z` is the normal load the tire carries, never
negative.

Assumptions: those of `SlipWheelJoint`. The wheel starts at rest; give another start at the
declaration, `Wheel(inertia(w = initial 64.5))`. Defaults are one wheel of the course's planar
car (assumed).
"""
component Wheel
  "Wheel center, with x along the wheel heading"
  frame_a = Frame2D() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 950, "y1": 250, "x2": 1050, "y2": 350},
        "diagram": {"x1": 950, "y1": 100, "x2": 1050, "y2": 200}
      }
    }
  }
  "Wheel shaft"
  spin = Spline() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 450, "x2": 50, "y2": 550},
        "diagram": {"x1": -50, "y1": 450, "x2": 50, "y2": 550}
      }
    }
  }
  "Normal load; positive presses the tire onto the road"
  load = Flange() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 950, "y1": 650, "x2": 1050, "y2": 750},
        "diagram": {"x1": 950, "y1": 450, "x2": 1050, "y2": 550}
      }
    }
  }
  "Road grip over world position"
  structural parameter grip::VehicleComponents.Road.Grip = VehicleComponents.Road.grip("dyad://VehicleComponents/data/roads/uniform_mu.crg")
  "Rolling radius"
  parameter radius::Length = 0.31
  "Spin inertia"
  parameter J::MomentOfInertia = 1.0
  "Peak adhesion coefficient"
  parameter mu_A::Real = 1.0
  "Sliding friction coefficient"
  parameter mu_S::Real = 0.8
  "Slip ratio at peak adhesion"
  parameter sAdhesion::Real = 0.12
  "Slip ratio at the sliding plateau"
  parameter sSlide::Real = 3 * sAdhesion
  "Longitudinal tire force on the vehicle"
  variable F_x::Dyad.Force
  "Lateral tire force on the vehicle"
  variable F_y::Dyad.Force
  "Normal load the tire carries"
  variable F_z::Dyad.Force
  tire = VehicleComponents.Body.Planar.SlipWheelJoint(radius = radius, mu_A = mu_A, mu_S = mu_S, sAdhesion = sAdhesion, sSlide = sSlide) {
    "Dyad": {"placement": {"diagram": {"x1": 700, "x2": 800, "y1": 450, "y2": 550}}}
  }
  road = VehicleComponents.Body.Planar.RoadGrip(road = grip) {
    "Dyad": {"placement": {"diagram": {"x1": 500, "x2": 600, "y1": 150, "y2": 250}}}
  }
  inertia = RotationalComponents.Components.Inertia(J = J, phi = initial 0.0, w = initial 0.0) {
    "Dyad": {"placement": {"diagram": {"x1": 550, "x2": 450, "y1": 450, "y2": 550}}}
  }
relations
  connect(frame_a, tire.frame_a) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [{"x": 800, "y": 150}, {"x": 800, "y": 400}, {"x": 770, "y": 400}],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  connect(frame_a, road.frame_a) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [
            {"x": 650, "y": 150},
            {"x": 650, "y": 100},
            {"x": 450, "y": 100},
            {"x": 450, "y": 200}
          ],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  connect(road.grip, tire.mu_scale) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [{"x": 700, "y": 200}, {"x": 700, "y": 400}, {"x": 725, "y": 400}],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  connect(load, tire.load) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(tire.spline, inertia.spline_a) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(inertia.spline_b, spin) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  F_x = tire.F_x
  F_y = tire.F_y
  F_z = tire.F_z
metadata {
  "Dyad": {"icons": {"default": "dyad://VehicleComponents/Body/Planar/Wheel.svg"}}
}
end

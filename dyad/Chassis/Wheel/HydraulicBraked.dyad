"""
Braked road wheel with hydraulic disc brakes: rotating inertia, a front-axle and a rear-axle
`Chassis.Brakes.Caliper` in the shaft line, and slip tire contact.

It is `Braked` with the commanded brake replaced by two calipers, one per brake circuit, so a
master cylinder drives it through brake lines.

Ports:
- `spline` the inboard shaft end; open when nothing drives the wheel.
- `support` takes both calipers' reaction. It must be connected, to the hub carrier or a
  `Fixed`: an open support takes no torque, so the calipers would apply none.
- `flange` attaches to the vehicle body.
- `front`, `rear` the front- and rear-circuit brake-fluid connections.
- `mu_scale` the road-friction multiplier, to the `Slip` tire.
- `kappa` the tire's slip ratio, negative while braking; no sensor dynamics.

Assumptions: the wheel starts at rest and both calipers empty; give another start at the
declaration, `HydraulicBraked(inertia(w = initial 80.0))`. Like `Braked`, the defaults lump the
whole 1400 kg car onto one equivalent wheel. `caliper_f` keeps the `Caliper` defaults, a compact
car's front axle, and `caliper_r` takes its rear axle's (textbook). Change any of them on the
part, `HydraulicBraked(caliper_r(K = 25e-5))`.
"""
component HydraulicBraked
  "Inboard shaft"
  spline = Spline() {"Dyad": {"placement": {"icon": {"x1": -50, "x2": 50, "y1": 450, "y2": 550}}}}
  "Brake reaction support; must be connected, to the hub carrier or a Fixed"
  support = Spline() {
    "Dyad": {
      "placement": {"icon": {"iconName": "support", "x1": 250, "x2": 350, "y1": 950, "y2": 1050}}
    }
  }
  "Longitudinal connection to the vehicle body"
  flange = Flange() {"Dyad": {"placement": {"icon": {"x1": 950, "x2": 1050, "y1": 450, "y2": 550}}}}
  "Front brake-circuit fluid connection"
  front = HydraulicComponents.Interfaces.Port() {
    "Dyad": {
      "placement": {
        "icon": {
          "iconName": "hydraulic_port_a",
          "x1": 150,
          "x2": 250,
          "y1": -50,
          "y2": 50,
          "rot": 270
        }
      }
    }
  }
  "Rear brake-circuit fluid connection"
  rear = HydraulicComponents.Interfaces.Port() {
    "Dyad": {
      "placement": {
        "icon": {
          "iconName": "hydraulic_port_a",
          "x1": 350,
          "x2": 450,
          "y1": -50,
          "y2": 50,
          "rot": 270
        }
      }
    }
  }
  "Road-friction multiplier"
  mu_scale = RealInput() {
    "Dyad": {
      "placement": {"icon": {"x1": 650, "x2": 750, "y1": 950, "y2": 1050, "rot": 270}}
    }
  }
  "Tire slip ratio, negative while braking"
  kappa = RealOutput() {
    "Dyad": {"placement": {"icon": {"x1": 750, "x2": 850, "y1": -50, "y2": 50, "rot": 270}}}
  }
  "Rotating inertia; four road wheels"
  inertia = RotationalComponents.Components.Inertia(J = 4.0, phi = initial 0.0, w = initial 0.0) {
    "Dyad": {
      "placement": {"diagram": {"x1": 1200, "x2": 1300, "y1": 400, "y2": 500, "rot": 270}}
    }
  }
  "Front-axle caliper"
  caliper_f = VehicleComponents.Chassis.Brakes.Caliper() {
    "Dyad": {
      "placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 250, "y2": 350, "rot": 180}}
    }
  }
  "Rear-axle caliper"
  caliper_r = VehicleComponents.Chassis.Brakes.Caliper(K = 19.9e-5, V0 = 0.3e-6, K1 = 2.5e12, K3 = 7.5e24) {
    "Dyad": {
      "placement": {"diagram": {"x1": 700, "x2": 800, "y1": 250, "y2": 350, "rot": 180}}
    }
  }
  "Tire; the normal load is the full weight of a 1400 kg car"
  tire = VehicleComponents.Chassis.Wheel.Slip(F_z = 13729.31) {
    "Dyad": {
      "placement": {"diagram": {"x1": 450, "x2": 550, "y1": 300, "y2": 400, "rot": 180}}
    }
  }
relations
  connect(spline, inertia.spline_a) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [{"x": 150, "y": 500}, {"x": 150, "y": 700}, {"x": 1250, "y": 700}],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  connect(inertia.spline_b, caliper_f.spline_a) {
    "Dyad": {"edges": [{"S": 1, "M": [{"x": 1250, "y": 300}], "E": 2}], "path": {}}
  }
  connect(caliper_f.spline_b, caliper_r.spline_a) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(caliper_r.spline_b, tire.spline) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 600, "y": 300}, {"x": 600, "y": 350}], "E": 2}],
      "path": {}
    }
  }
  connect(caliper_f.support, caliper_r.support) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 1000, "y": 200}, {"x": 750, "y": 200}], "E": 2}],
      "path": {}
    }
  }
  connect(caliper_r.support, support) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [
            {"x": 750, "y": 150},
            {"x": 1350, "y": 150},
            {"x": 1350, "y": 950},
            {"x": 300, "y": 950}
          ],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  connect(caliper_f.port, front) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [
            {"x": 1000, "y": 450},
            {"x": 1050, "y": 450},
            {"x": 1050, "y": 650},
            {"x": 200, "y": 650}
          ],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  connect(caliper_r.port, rear) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 750, "y": 500}, {"x": 400, "y": 500}], "E": 2}],
      "path": {}
    }
  }
  connect(tire.flange, flange) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [{"x": 350, "y": 350}, {"x": 350, "y": 550}, {"x": 1000, "y": 550}],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  connect(mu_scale, tire.mu_scale) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [
            {"x": 700, "y": 600},
            {"x": 300, "y": 600},
            {"x": 300, "y": 250},
            {"x": 525, "y": 250}
          ],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  connect(tire.kappa, kappa) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [
            {"x": 475, "y": 450},
            {"x": 650, "y": 450},
            {"x": 650, "y": 50},
            {"x": 800, "y": 50}
          ],
          "E": 2
        }
      ],
      "path": {}
    }
  }
metadata {
  "Dyad": {
    "icons": {"default": "dyad://VehicleComponents/Chassis/Wheel/HydraulicBraked.svg"}
  }
}
end

"""
One axle's hydraulic disc brakes: the caliper's fluid compliance and the friction torque its
pressure clamps onto the disc.

The caliper sits in the shaft line between `spline_a` and `spline_b` and passes its reaction to
the `support` housing; the disc is rigid with the shaft, so both splines share one angle.

Ports: `spline_a`, `spline_b` the shaft ends; `support` the housing (hub carrier); `port` the
brake-fluid connection.

The admitted fluid volume V sets the pressure. Up to the clearance take-up volume `V0` the pads
travel against a soft linear law, p = p0 V/V0; beyond it they press the disc and the stiffness
rises cubically, p = p0 + K1 u + K3 u³ with u = V - V0. The friction torque magnitude is
K max(0, p - p0) and acts against the shaft's rotation.

Assumptions: the caliper starts empty, V = 0. Below `w0` the friction direction sign(w) is
replaced by the sine ramp sin(pi/2 w/w0), as in `Chassis.Wheel.BrakeActuator`, so the brake holds
no torque at exact standstill. The defaults are a front axle's (textbook).
"""
component Caliper
  extends RotationalComponents.Interfaces.PartialElementaryTwoSplinesAndSupport
  "Brake-fluid connection"
  port = HydraulicComponents.Interfaces.Port() {^port}
  "Torque gain [N m/Pa]"
  parameter K::Real = 49.0e-5
  "Pad-contact pressure"
  parameter p0::Pressure = 0.5e5
  "Clearance take-up volume"
  parameter V0::Volume = 0.5e-6
  "Linear pressure-volume coefficient [Pa/m³]"
  parameter K1::Real = 1e12
  "Cubic pressure-volume coefficient [Pa/m⁹]"
  parameter K3::Real = 4.8e23
  "Shaft speed below which the friction direction is ramped"
  parameter w0::AngularVelocity(min = eps(Float64)) = 0.2
  "Fluid volume admitted to the caliper"
  variable V::Volume = initial 0.0
  "Caliper pressure"
  variable p::Pressure
  "Fluid density at the caliper pressure"
  variable rho::Density
  "Volume beyond the clearance take-up"
  variable u::Volume
  "Brake-torque magnitude"
  variable tau::Torque
  "Shaft angle relative to the support"
  variable phi::Angle
  "Shaft speed relative to the support"
  variable w::AngularVelocity
  "Friction torque removed from the shaft line, with the sign of w"
  variable tau_friction::Torque
relations
  phi = spline_a.phi - phi_support
  w = der(phi)
  spline_b.phi = spline_a.phi
  port.p = p
  rho = HydraulicComponents.density(port.medium, p)
  der(V) = port.m_flow / rho
  u = V - V0
  p = ifelse(V < V0, p0 * V / V0, p0 + K1 * u + K3 * u ^ 3)
  tau = K * max(0.0, p - p0)
  tau_friction = tau * ifelse(abs(w) >= w0, sign(w), sin(π / 2 * w / w0))
  spline_a.tau + spline_b.tau = tau_friction
metadata {
  "Dyad": {"icons": {"default": "dyad://VehicleComponents/Chassis/Brakes/Caliper.svg"}},
  "_links": {
    "port": {
      "Dyad": {
        "placement": {"icon": {"iconName": "hydraulic_port_a", "x1": 450, "x2": 550, "y1": -50, "y2": 50, "rot": 270}}
      }
    }
  }
}
end

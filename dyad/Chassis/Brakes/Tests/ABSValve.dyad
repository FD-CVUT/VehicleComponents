"""
One default `ABSValve` (T_v = 0.03 s) between a master-cylinder side held at 10 MPa gauge
(10100325 Pa absolute, p_amb = 100325 Pa) and a default `Caliper` behind a default `Line`. The
disc and the caliper housing are fixed. The allowed pressure p_cmd is constant, set per case.

The caliper's pressure-volume law is the `Caliper` rig's: at 10 MPa it holds V = 2.99499e-6 m³.
At 4 MPa, p - p0 = 3.95e6 = 1e12 u + 4.8e23 u³, and bisection on [0, 1e-4] gives
u = 1.678818e-6 m³ (K1 u = 1.678818e6 Pa, K3 u³ = 2.271182e6 Pa), so V = 2.178818e-6 m³. The
valve's lag, 0.03 s, and the line's fill, under 0.08 s (the `Caliper` rig), have both settled
by 1 s.

- `open`, p_cmd = 20 MPa, above the master-cylinder side: the inlet stays open and the caliper
  fills to 10 MPa, V = 2.99499e-6 m³.
- `limited`, p_cmd = 4 MPa: the valve lets the caliper rise only to the command, so it fills
  from empty to 4 MPa, V = 2.178818e-6 m³.
- `dump`, p_cmd = 4 MPa, the caliper starting full at 10 MPa (V = 2.99499e-6 m³, the valve
  holding 10 MPa): the valve dumps the caliper down to 4 MPa, V = 2.178818e-6 m³, with the
  master-cylinder side still at 10 MPa.
"""
test component ABSValve
  "Master-cylinder side, absolute"
  pressure = BlockComponents.Sources.Constant(k = 10100325.0) {
    "Dyad": {"placement": {"diagram": {"x1": 200, "x2": 300, "y1": 200, "y2": 300}}}
  }
  supply = HydraulicComponents.Sources.BoundaryPressure() {
    "Dyad": {"placement": {"diagram": {"x1": 450, "x2": 550, "y1": 200, "y2": 300}}}
  }
  "Allowed wheel-circuit pressure, gauge, overridden per case"
  command = BlockComponents.Sources.Constant(k = 4.0e6) {
    "Dyad": {"placement": {"diagram": {"x1": 600, "x2": 700, "y1": 450, "y2": 550}}}
  }
  valve = VehicleComponents.Chassis.Brakes.ABSValve() {
    "Dyad": {"placement": {"diagram": {"x1": 700, "x2": 800, "y1": 200, "y2": 300}}}
  }
  line = VehicleComponents.Chassis.Brakes.Line() {
    "Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 200, "y2": 300}}}
  }
  caliper = VehicleComponents.Chassis.Brakes.Caliper() {
    "Dyad": {"placement": {"diagram": {"x1": 1300, "x2": 1200, "y1": 200, "y2": 300}}}
  }
  "Disc held still"
  disc = RotationalComponents.Components.Fixed() {
    "Dyad": {
      "placement": {"diagram": {"x1": 1450, "x2": 1550, "y1": 200, "y2": 300, "rot": 270}}
    }
  }
  housing = RotationalComponents.Components.Fixed() {
    "Dyad": {"placement": {"diagram": {"x1": 1200, "x2": 1300, "y1": 450, "y2": 550}}}
  }
  "DOT 4 brake fluid"
  path medium::HydraulicComponents.Interfaces.AbstractMedium = VehicleComponents.DOT4
relations
  connect(pressure.y, supply.p) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(supply.port, valve.port_a) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(command.y, valve.p_cmd) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 750, "y": 500}], "E": 2}], "path": {}}}
  connect(valve.port_b, line.port_a) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(line.port_b, caliper.port) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [{"x": 1150, "y": 250}, {"x": 1150, "y": 150}, {"x": 1250, "y": 150}],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  continuity(medium, supply.port.medium)
  connect(caliper.spline_a, disc.spline) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(caliper.support, housing.spline) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
metadata {
  "Dyad": {
    "tests": {
      "open": {
        "stop": 1,
        "solver": "Auto",
        "abstol": 1e-10,
        "reltol": 1e-8,
        "params": {"command.k": 2.0e7},
        "atol": {"caliper.p": 1.0, "caliper.V": 1e-11},
        "expect": {"final": {"caliper.p": 1.0e7, "caliper.V": 2.99499e-6}}
      },
      "limited": {
        "stop": 1,
        "solver": "Auto",
        "abstol": 1e-10,
        "reltol": 1e-8,
        "atol": {"caliper.p": 1.0, "caliper.V": 1e-11},
        "expect": {
          "initial": {"caliper.V": 0.0},
          "final": {"caliper.p": 4.0e6, "caliper.V": 2.178818e-6}
        }
      },
      "dump": {
        "stop": 1,
        "solver": "Auto",
        "abstol": 1e-10,
        "reltol": 1e-8,
        "initial": {"caliper.V": 2.99499e-6, "valve.p_hold": 1.0e7},
        "atol": {"caliper.p": 1.0, "caliper.V": 1e-11, "valve.p_a": 1.0},
        "expect": {"final": {"caliper.p": 4.0e6, "caliper.V": 2.178818e-6, "valve.p_a": 1.0e7}}
      }
    }
  }
}
end

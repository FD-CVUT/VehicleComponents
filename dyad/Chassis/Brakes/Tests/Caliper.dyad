"""
One default caliper (K = 49e-5 N m/Pa, p0 = 0.5e5 Pa, V0 = 0.5e-6 m³, K1 = 1e12 Pa/m³,
K3 = 4.8e23 Pa/m⁹) filled from a constant pressure through a default `Line` (3 mm bore, 1.5 m). It
brakes a J = 100 kg m² shaft spinning at 100 rad/s, its housing fixed. The pressure is set per
case.

Once the caliper has filled, no fluid flows and it sits at the line pressure p. The line's
resistance R = 7.545e6 Pa s/kg (see the `Line` rig) and the caliper's compliance rho dV/dp fill it
with a time constant of R rho V0/p0 = 7.545e6 · 1045 · 1e-11 = 0.079 s below p0, and faster above
it, so within the 2 s run the pressure error decays by e^-25. The caliper decelerates the shaft by
at most 4875.5/100 = 48.8 rad/s², so in 2 s it keeps turning above 100 - 97.5 = 2.5 rad/s, well
above w0, and the full torque acts.

- `clearance`, 0.25 bar, below p0: the pads have not reached the disc. V = V0 p/p0 = 0.5e-6 ·
  0.5 = 0.25e-6 m³ and the torque is 0.
- `applied`, 100 bar: the pads press the disc, p - p0 = K1 u + K3 u³ = 9.95e6 Pa. Bisection on
  [0, 1e-4] gives u = 2.49499e-6 m³ (K1 u = 2.49499e6 Pa, K3 u³ = 7.45501e6 Pa), so
  V = 2.99499e-6 m³, and tau = 49e-5 · 9.95e6 = 4875.5 N m. The friction torque has the sign of w,
  so it is +4875.5 N m too.
"""
test component Caliper
  "Line pressure, overridden per case"
  pressure = BlockComponents.Sources.Constant(k = 1.0e7) {
    "Dyad": {"placement": {"diagram": {"x1": 200, "x2": 300, "y1": 200, "y2": 300}}}
  }
  supply = HydraulicComponents.Sources.BoundaryPressure() {
    "Dyad": {"placement": {"diagram": {"x1": 450, "x2": 550, "y1": 200, "y2": 300}}}
  }
  line = VehicleComponents.Chassis.Brakes.Line() {
    "Dyad": {"placement": {"diagram": {"x1": 700, "x2": 800, "y1": 200, "y2": 300}}}
  }
  caliper = VehicleComponents.Chassis.Brakes.Caliper() {
    "Dyad": {"placement": {"diagram": {"x1": 1050, "x2": 950, "y1": 200, "y2": 300}}}
  }
  disc = RotationalComponents.Components.Inertia(J = 100.0, phi = initial 0.0, w = initial 100.0) {
    "Dyad": {
      "placement": {"diagram": {"x1": 1200, "x2": 1300, "y1": 200, "y2": 300, "rot": 180}}
    }
  }
  housing = RotationalComponents.Components.Fixed() {
    "Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 450, "y2": 550}}}
  }
  "DOT 4 brake fluid"
  path medium::HydraulicComponents.Interfaces.AbstractMedium = HydraulicComponents.IsothermalCompressible(bulk_modulus = 1.4e9, density = 1045.0, let_gas = false)
relations
  connect(pressure.y, supply.p) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(supply.port, line.port_a) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(line.port_b, caliper.port) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [{"x": 900, "y": 250}, {"x": 900, "y": 150}, {"x": 1000, "y": 150}],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  continuity(medium, supply.port.medium)
  connect(disc.spline_b, caliper.spline_a) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(caliper.support, housing.spline) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
metadata {
  "Dyad": {
    "tests": {
      "clearance": {
        "stop": 2,
        "solver": "Auto",
        "abstol": 1e-10,
        "reltol": 1e-8,
        "params": {"pressure.k": 2.5e4},
        "atol": {"caliper.p": 0.1, "caliper.V": 1e-12, "caliper.tau": 1e-6},
        "expect": {
          "initial": {"caliper.V": 0.0},
          "final": {"caliper.p": 2.5e4, "caliper.V": 0.25e-6, "caliper.tau": 0.0}
        }
      },
      "applied": {
        "stop": 2,
        "solver": "Auto",
        "abstol": 1e-10,
        "reltol": 1e-8,
        "atol": {
          "caliper.p": 1.0,
          "caliper.V": 1e-11,
          "caliper.tau": 0.001,
          "caliper.tau_friction": 0.001
        },
        "expect": {
          "final": {
            "caliper.p": 1.0e7,
            "caliper.V": 2.99499e-6,
            "caliper.tau": 4875.5,
            "caliper.tau_friction": 4875.5
          }
        }
      }
    }
  }
}
end

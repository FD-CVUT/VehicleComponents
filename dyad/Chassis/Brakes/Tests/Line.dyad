"""
One default line (D = 3 mm, L = 1.5 m, nu = 10e-6 m²/s) between two fixed pressures: 1 bar more
at `port_a` than at `port_b` (set per case). The Hagen-Poiseuille resistance is
128 nu L/(pi D⁴) = 128 · 10e-6 · 1.5/(pi · 8.1e-11) = 7.545123e6 Pa s/kg, so

- `forward`, 1e5 Pa: m_flow = 1e5/7.545123e6 = 0.01325359 kg/s from `port_a` to `port_b`.
- `reverse`, -1e5 Pa: the same flow the other way, -0.01325359 kg/s.
"""
test component Line
  "Upstream pressure above the downstream one, overridden per case"
  upstream = BlockComponents.Sources.Constant(k = 2.0e5) {
    "Dyad": {"placement": {"diagram": {"x1": 200, "x2": 300, "y1": 200, "y2": 300}}}
  }
  downstream = BlockComponents.Sources.Constant(k = 1.0e5) {
    "Dyad": {"placement": {"diagram": {"x1": 200, "x2": 300, "y1": 450, "y2": 550}}}
  }
  supply = HydraulicComponents.Sources.BoundaryPressure() {
    "Dyad": {"placement": {"diagram": {"x1": 450, "x2": 550, "y1": 200, "y2": 300}}}
  }
  line = VehicleComponents.Chassis.Brakes.Line() {
    "Dyad": {
      "placement": {"diagram": {"x1": 700, "x2": 800, "y1": 350, "y2": 450, "rot": 90}}
    }
  }
  drain = HydraulicComponents.Sources.BoundaryPressure() {
    "Dyad": {"placement": {"diagram": {"x1": 450, "x2": 550, "y1": 450, "y2": 550}}}
  }
  "DOT 4 brake fluid"
  path medium::HydraulicComponents.Interfaces.AbstractMedium = HydraulicComponents.IsothermalCompressible(bulk_modulus = 1.4e9, density = 1045.0, let_gas = false)
relations
  connect(upstream.y, supply.p) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(supply.port, line.port_a) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 750, "y": 250}], "E": 2}], "path": {}}}
  connect(line.port_b, drain.port) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 750, "y": 500}], "E": 2}], "path": {}}}
  connect(downstream.y, drain.p) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  continuity(medium, supply.port.medium)
metadata {
  "Dyad": {
    "tests": {
      "forward": {
        "stop": 1,
        "solver": "Auto",
        "abstol": 1e-10,
        "reltol": 1e-10,
        "atol": {"line.m_flow": 1e-8},
        "expect": {"final": {"line.m_flow": 0.01325359}}
      },
      "reverse": {
        "stop": 1,
        "solver": "Auto",
        "abstol": 1e-10,
        "reltol": 1e-10,
        "params": {"upstream.k": 0.0},
        "atol": {"line.m_flow": 1e-8},
        "expect": {"final": {"line.m_flow": -0.01325359}}
      }
    }
  }
}
end

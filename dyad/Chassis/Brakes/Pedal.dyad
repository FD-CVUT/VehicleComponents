"""
Brake pedal: an ideal, massless lever that the driver's foot pushes with a commanded force.

Ports: `u` the pedal command, the foot force as a fraction of `F_max`, clamped to 0 to 1 the way a
throttle command is a fraction of full throttle; `rod` the pushrod to the booster; `support` the
pivot, which takes the lever's reaction. The foot pushes against the car, so its reaction goes
into `support` with the pivot's.

The lever multiplies the foot force F_ped by `i_p` at the pushrod, F_rod = i_p F_ped, and the
pedal travels `i_p` times the pushrod's travel relative to the pivot. The flange forces follow
the stdlib's sign, the force on this part along s, so the pedal pushes the rod toward +s.

Assumptions: no pedal mass, friction or return spring; the foot force is whatever the command
asks, whatever the pedal's travel. Defaults: `i_p` 3.5 (assumed; OEM boosted pedals span 3.2 to
5), `F_max` 500 N, the foot-force ceiling of an FMVSS 135 brake test.
"""
component Pedal
  "Pedal command: foot force as a fraction of F_max, 0 to 1"
  u = RealInput() {^u}
  "Pushrod to the booster"
  rod = Flange() {^rod}
  "Pedal pivot, which takes the lever's reaction"
  support = Flange() {^support}
  "Pedal lever ratio"
  parameter i_p::Real = 3.5
  "Foot force at full pedal"
  parameter F_max::Force = 500.0
  "Driver's foot-force magnitude"
  variable F_ped::Force
  "Force delivered at the pushrod"
  variable F_rod::Force
  "Pedal travel relative to the pivot"
  variable x_ped::Length
  "Pushrod travel relative to the pivot"
  variable x_rod::Length
relations
  x_rod = rod.s - support.s
  x_ped = i_p * x_rod
  F_ped = min(max(u, 0.0), 1.0) * F_max
  F_rod = -rod.f
  F_rod = i_p * F_ped
  rod.f + support.f = 0.0
metadata {
  "Dyad": {"icons": {"default": "dyad://VehicleComponents/Chassis/Brakes/Pedal.svg"}},
  "_links": {
    "u": {
      "Dyad": {"placement": {"icon": {"x1": -50, "x2": 50, "y1": 450, "y2": 550}}}
    },
    "rod": {
      "Dyad": {"placement": {"icon": {"iconName": "flange_b", "x1": 950, "x2": 1050, "y1": 450, "y2": 550}}}
    },
    "support": {
      "Dyad": {"placement": {"icon": {"iconName": "flange_b", "x1": 450, "x2": 550, "y1": 950, "y2": 1050, "rot": 90}}}
    }
  }
}
end

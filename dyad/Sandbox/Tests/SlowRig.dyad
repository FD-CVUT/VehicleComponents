"Throwaway rig: a long diffusion chain, to overrun the per-rig budget"
test component SlowRig
  structural parameter N::Integer = 3000
  variable x::Real[N]
relations
  for i in 1:N
    initial x[i] = 0
  end
  der(x[1]) = 1 - 2 * x[1] + x[2]
  for i in 2:N-1
    der(x[i]) = x[i-1] - 2 * x[i] + x[i+1]
  end
  der(x[N]) = x[N-1] - 2 * x[N]
metadata {"Dyad": {"tests": {"case1": {"stop": 100, "expect": {"initial": {"x[1]": 0}}}}}}
end

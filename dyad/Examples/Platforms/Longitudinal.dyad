"""
Longitudinal platform: a driver whose pedals command an ideal net force on a point-mass body on a
flat road.

Subsystems: `driver`, any `Driver.Interface` (default `Driver.CoastDown`), replaceable by
redeclaration; `pedals`, the net force F_drive * throttle - F_brake * brake; `motor`, the ideal
force source it drives against `fixed`; `body`, a `Body.Longitudinal.Vehicle` starting at rest;
`level` and `tire`, its grade (0) and rolling resistance coefficient (0.012).

Assumptions: the brake is an ideal force, not friction, so it pushes the car backward once it has
stopped; a run ends before standstill. The steering signal is unused.
"""
partial component Longitudinal
  driver::VehicleComponents.Driver.Interface = VehicleComponents.Driver.CoastDown() {^driver}
  pedals = BlockComponents.Math.Add(k1 = F_drive, k2 = -F_brake) {^pedals}
  motor = TranslationalComponents.Sources.Force() {^motor}
  fixed = TranslationalComponents.Components.Fixed() {^fixed}
  body = VehicleComponents.Body.Longitudinal.Vehicle() {^body}
  "Flat road"
  level = BlockComponents.Sources.Constant(k = 0.0) {^level}
  "Car tire on asphalt"
  tire = BlockComponents.Sources.Constant(k = 0.012) {^tire}
  "Tractive force at full throttle"
  parameter F_drive::Force = 3000.0
  "Braking force at full brake pedal"
  parameter F_brake::Force = 6000.0
relations
  connect(driver.throttle_signal, pedals.u1) {^w1}
  connect(driver.brake_signal, pedals.u2) {^w2}
  connect(pedals.y, motor.f) {^w3}
  connect(motor.flange_a, fixed.flange) {^w4}
  connect(motor.flange_b, body.flange) {^w5}
  connect(tire.y, body.f_r) {^w6}
  connect(level.y, body.grade) {^w7}
  initial body.mass.s = 0.0
  initial body.mass.v = 0.0
metadata {
  "_links": {
    "driver": {"Dyad": {"placement": {"diagram": {"x1": 100, "x2": 340, "y1": 90, "y2": 330}}}},
    "pedals": {"Dyad": {"placement": {"diagram": {"x1": 440, "x2": 540, "y1": 130, "y2": 230}}}},
    "motor": {"Dyad": {"placement": {"diagram": {"x1": 640, "x2": 740, "y1": 230, "y2": 330}}}},
    "fixed": {"Dyad": {"placement": {"diagram": {"x1": 540, "x2": 640, "y1": 350, "y2": 450}}}},
    "body": {"Dyad": {"placement": {"diagram": {"x1": 900, "x2": 1100, "y1": 230, "y2": 430}}}},
    "tire": {"Dyad": {"placement": {"diagram": {"x1": 700, "x2": 800, "y1": 550, "y2": 650}}}},
    "level": {"Dyad": {"placement": {"diagram": {"x1": 700, "x2": 800, "y1": 700, "y2": 800}}}},
    "w1": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w2": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},

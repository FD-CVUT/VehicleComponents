    "w5": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 790, "y": 280}, {"x": 790, "y": 190}, {"x": 1150, "y": 190}, {"x": 1150, "y": 330}], "E": 2}]}},
    "w6": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 850, "y": 600}, {"x": 850, "y": 280}], "E": 2}]}},

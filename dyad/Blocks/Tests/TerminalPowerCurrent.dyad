"""
20 kW at 400 V is 50 A, and -20 kW is -50 A. At 0 V the one-volt floor gives 20000 A instead of
a division by zero.
"""
test component TerminalPowerCurrent
  pack = BlockComponents.Sources.Constant(k = 400.0)
  dead = BlockComponents.Sources.Constant(k = 0.0)
  charge = VehicleComponents.Blocks.TerminalPowerCurrent(P = 20000.0)
  discharge = VehicleComponents.Blocks.TerminalPowerCurrent(P = -20000.0)
  floored = VehicleComponents.Blocks.TerminalPowerCurrent(P = 20000.0)
relations
  connect(pack.y, charge.u, discharge.u)
  connect(dead.y, floored.u)
metadata {
  "Dyad": {
    "tests": {
      "power_to_current": {
        "stop": 1,
        "solver": "Auto",
        "abstol": 1e-9,
        "reltol": 1e-9,
        "atol": {"charge.y": 1e-9, "discharge.y": 1e-9, "floored.y": 1e-6},
        "expect": {"final": {"charge.y": 50.0, "discharge.y": -50.0, "floored.y": 20000.0}}
      }
    }
  }
}
end

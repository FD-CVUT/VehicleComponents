"""
Two switches fed the same two constants, one with `on` and one without: the first passes `u1`
(1), the second `u2` (2).
"""
test component ParameterSwitch
  first = BlockComponents.Sources.Constant(k = 1.0) {
    "Dyad": {"placement": {"diagram": {"x1": 200, "x2": 300, "y1": 200, "y2": 300}}}
  }
  second = BlockComponents.Sources.Constant(k = 2.0) {
    "Dyad": {"placement": {"diagram": {"x1": 200, "x2": 300, "y1": 550, "y2": 650}}}
  }
  on = VehicleComponents.Blocks.ParameterSwitch(on = true) {
    "Dyad": {
      "placement": {"diagram": {"x1": 500, "x2": 600, "y1": 200, "y2": 300, "rot": 270}}
    }
  }
  off = VehicleComponents.Blocks.ParameterSwitch(on = false) {
    "Dyad": {"placement": {"diagram": {"x1": 450, "x2": 550, "y1": 450, "y2": 550}}}
  }
relations
  connect(first.y, on.u1) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [{"x": 450, "y": 250}, {"x": 450, "y": 350}, {"x": 520, "y": 350}],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  connect(first.y, off.u1) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 400, "y": 250}, {"x": 400, "y": 470}], "E": 2}],
      "path": {}
    }
  }
  connect(second.y, on.u2) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [{"x": 600, "y": 600}, {"x": 600, "y": 350}, {"x": 580, "y": 350}],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  connect(second.y, off.u2) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 400, "y": 600}, {"x": 400, "y": 530}], "E": 2}],
      "path": {}
    }
  }
metadata {
  "Dyad": {
    "tests": {
      "both_settings": {
        "stop": 1,
        "solver": "Auto",
        "abstol": 1e-9,
        "reltol": 1e-9,
        "atol": {"on.y": 1e-9, "off.y": 1e-9},
        "expect": {"final": {"on.y": 1.0, "off.y": 2.0}}
      }
    }
  }
}
end

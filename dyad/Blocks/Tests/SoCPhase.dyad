"""
With a 2 s period, 0.5 s is 0.5 s into the first cycle and 5 s is 1 s into the third.
"""
test component SoCPhase
  early = BlockComponents.Sources.Constant(k = 0.5)
  late = BlockComponents.Sources.Constant(k = 5.0)
  first_cycle = VehicleComponents.Blocks.SoCPhase(period = 2.0)
  third_cycle = VehicleComponents.Blocks.SoCPhase(period = 2.0)
relations
  connect(early.y, first_cycle.u)
  connect(late.y, third_cycle.u)
metadata {
  "Dyad": {
    "tests": {
      "wraps": {
        "stop": 1,
        "solver": "Auto",
        "abstol": 1e-9,
        "reltol": 1e-9,
        "atol": {"first_cycle.y": 1e-9, "third_cycle.y": 1e-9},
        "expect": {"final": {"first_cycle.y": 0.5, "third_cycle.y": 1.0}}
      }
    }
  }
}
end
